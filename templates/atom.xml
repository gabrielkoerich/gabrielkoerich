{#- Zola's default feed with two changes: posts only, and scheduled posts stay out until the daily deploy on their date, like sitemap.xml -#}
{%- set today = now() | date(format="%Y%m%d") | int -%}
{%- set_global entries = [] -%}
{%- for page in pages -%}
{%- if page.date and page.relative_path is starting_with("posts/") -%}
{%- set day = page.date | date(format="%Y%m%d") | int -%}
{%- if day <= today -%}{%- set_global entries = entries | concat(with=page) -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ lang }}">
    <title>{{ config.title }}</title>
    <subtitle>{{ config.description }}</subtitle>
    <link rel="self" type="application/atom+xml" href="{{ feed_url | safe }}"/>
    <link rel="alternate" type="text/html" href="{{ config.base_url | safe }}/"/>
    <generator uri="https://www.getzola.org/">Zola</generator>
    {%- if entries %}
    {%- set newest = entries | first %}
    <updated>{{ newest.updated | default(value=newest.date) | date(format="%+") }}</updated>
    {%- endif %}
    <id>{{ feed_url | safe }}</id>
    {%- for page in entries %}
    <entry xml:lang="{{ page.lang }}">
        <title>{{ page.title }}</title>
        <published>{{ page.date | date(format="%+") }}</published>
        <updated>{{ page.updated | default(value=page.date) | date(format="%+") }}</updated>
        <author>
            <name>{{ config.extra.author }}</name>
        </author>
        <link rel="alternate" type="text/html" href="{{ page.permalink | safe }}"/>
        <id>{{ page.permalink | safe }}</id>
        {%- if page.description %}
        <summary>{{ page.description }}</summary>
        {%- endif %}
        <content type="html" xml:base="{{ page.permalink | escape_xml | safe }}">{{ page.content }}</content>
    </entry>
    {%- endfor %}
</feed>
